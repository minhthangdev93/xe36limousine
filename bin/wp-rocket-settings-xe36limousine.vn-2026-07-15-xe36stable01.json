{
  "cache_mobile": 1,
  "do_caching_mobile_files": 1,
  "cache_webp": 0,
  "cache_logged_user": 0,
  "cache_ssl": 1,
  "emoji": 1,
  "embeds": 0,
  "cache_reject_uri": [
    "/(.*)wp-admin/(.*)",
    "/(.*)wp-login.php(.*)",
    "/(.*)xmlrpc.php(.*)",
    "/(.*)wp-json/(.*)",
    "/(.*)feed(.*)",
    "/(.*)sitemap(.*).xml(.*)"
  ],
  "cache_reject_cookies": [
    "wordpress_logged_in_",
    "wp-postpass_",
    "woocommerce_items_in_cart",
    "woocommerce_cart_hash"
  ],
  "cache_reject_ua": [],
  "cache_query_strings": [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content",
    "gclid",
    "fbclid"
  ],
  "cache_purge_pages": [],
  "purge_cron_interval": 10,
  "purge_cron_unit": "HOUR_IN_SECONDS",
  "exclude_css": [
    "/wp-content/themes/oceanwp-child/assets/css/homepage-critical.css"
  ],
  "exclude_js": [
    "/wp-content/themes/oceanwp-child/assets/js/booking.js",
    "/wp-content/themes/oceanwp-child/assets/js/gallery-carousel.js",
    "/jquery(-migrate)?(.min)?.js",
    "/wp-includes/js/jquery/"
  ],
  "exclude_inline_js": [
    "xe36",
    "gtag",
    "dataLayer",
    "admin-ajax"
  ],
  "defer_all_js": 1,
  "exclude_defer_js": [
    "/jquery(-migrate)?(.min)?.js",
    "/wp-includes/js/jquery/"
  ],
  "async_css": 0,
  "critical_css": "",
  "remove_unused_css": 0,
  "remove_unused_css_safelist": [],
  "lazyload": 1,
  "lazyload_css_bg_img": 0,
  "lazyload_iframes": 1,
  "lazyload_youtube": 1,
  "image_dimensions": 1,
  "minify_css": 1,
  "minify_js": 1,
  "minify_concatenate_js": 0,
  "minify_google_fonts": 1,
  "manual_preload": 0,
  "sitemap_preload": 0,
  "automatic_preload": 0,
  "preload_links": 1,
  "preload_fonts": [],
  "dns_prefetch": [
    "//www.googletagmanager.com",
    "//www.google-analytics.com",
    "//i.ytimg.com",
    "//www.youtube.com"
  ],
  "delay_js": 0,
  "delay_js_exclusions": [
    "/jquery(-migrate)?(.min)?.js",
    "/wp-content/themes/oceanwp-child/assets/js/booking.js",
    "/wp-content/themes/oceanwp-child/assets/js/gallery-carousel.js",
    "/wp-content/themes/oceanwp-child/assets/js/header.js",
    "gtag",
    "googletagmanager"
  ],
  "database_revisions": 0,
  "database_auto_drafts": 0,
  "database_trashed_posts": 0,
  "database_spam_comments": 0,
  "database_trashed_comments": 0,
  "database_all_transients": 0,
  "database_optimize_tables": 0,
  "schedule_automatic_cleanup": 0,
  "automatic_cleanup_frequency": "weekly",
  "cdn": 0,
  "cdn_cnames": [],
  "cdn_zone": [],
  "cdn_reject_files": [],
  "do_cloudflare": 0,
  "cloudflare_email": "",
  "cloudflare_api_key": "",
  "cloudflare_zone_id": "",
  "cloudflare_devmode": 0,
  "cloudflare_protocol_rewrite": 0,
  "cloudflare_auto_settings": 0,
  "cloudflare_old_settings": "",
  "control_heartbeat": 1,
  "heartbeat_site_behavior": "reduce_periodicity",
  "heartbeat_admin_behavior": "reduce_periodicity",
  "heartbeat_editor_behavior": "reduce_periodicity",
  "varnish_auto_purge": 0,
  "analytics_enabled": 0,
  "sucury_waf_cache_sync": 0,
  "sucury_waf_api_key": "",
  "host_fonts_locally": 0,
  "auto_preload_newly_published_content": 0
}
